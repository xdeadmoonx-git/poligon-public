        $ persistent.poligon_characters["uvao"]["descs"].append(
            "\n\"Я всегда любила мотыльков...\"\n\nМотылёк — олицетворение души Юли, зеркало её внутренних порывов и эмоций. \"Мотыльки сами находят свою смерть\" — так её подсознание рисует параллель между собой и своей судьбой."
            )
        $ poligon_notice("Обновление персонажа: Юля")
    window hide
    with dissolve

label poligon_chapter_1_prolog:
    show videos poligon_cave
    $ renpy.pause(30, hard=True)
    hide videos poligon_cave
    $ poligon_sprite_set = "sunset"
    $ persistent.sprite_time = "sunset"
    $ poligon_say_set = "sunset"
    $ renpy.pause (2.5, hard=True)
    if persistent.poligon_videoplayers["cave"]["unlocked"] == False and persistent.poligon_music["progulka"]["unlocked"] == False:
        $ persistent.poligon_videoplayers["cave"]["unlocked"] = True
        $ persistent.poligon_music["progulka"]["unlocked"] = True
    play music poligon_progulka fadein 3.0
    scene bg poligon_ext_path2_sunset with Dissolve(2.5)
    "Я помню, как в детстве играл с какими-то ребятами на очень старой площадке." with Dissolve(2.5)
    "Песок{w}, горка{w} и ушибленные колени от игры в футбол, кто-то кричит, чтобы мы были поосторожнее..." 
    "Интересно, где и когда это было?{w} Я не помню. Но тогда, мне кажется, я был счастлив."
    "Сейчас я брел по лесу без особой цели - просто чтобы проветрить голову."
    "Порой, просто глядя на облака, можно высвободить душу из клетки, в которую ее заточило сознание."
    "Эти места...{w}Я припоминаю здешний лес. Вчера я случайно сюда зашёл, пока пытался найти укромное место, чтобы побыть одному."
    if persistent.poligon_characters["semen"]["unlocked"] == False:
        $ persistent.poligon_characters["semen"]["unlocked"] = True
        $ persistent.poligon_characters["semen"]["descs"].append(
            "Семён Персунов — непримечательный внешностью парень, но с довольно нетипичной историей. Русые волосы и бледно-голубые глаза не выдают в нём ничего экстравагантного, но из раза в раз он мучается от постоянных недомоганий восприятия внешнего мира. Ему кажется всё нереальным и неестественным, скорее инородным по отношению к себе."
            )
        $ poligon_notice("Открытие персонажа: Семён Персунов")
    ptho "Опять этот странный туман в воспоминаниях. Лагерь, пионеры, вожатая...{w} Меня здесь точно быть не должно."
    "Так мне думалось все чаще. Иногда, я чувствую, что само место пытается меня догнать, а не я это место."
    "Ольга Дмитриевна часто говорила, что в этом лесу могут водиться хищные особи и просила не заходить сюда."
    "Но куда идти чтобы скрыться от чужих глаз?"
    stop music fadeout 0.3
    play sound poligon_listva
    play sound2 poligon_lira
    play ambience poligon_forest_evening fadein 1.5
    ptho "Что это там?"
    "Впереди мелькнуло движение."
    ptho "Животное, что ли?{w} Или птица?"
    "Любопытство победило инстинкт самосохранения, и я направился к источнику звука."
    play sound poligon_trava 
    scene bg poligon_ext_path2_sunset at poligon_move(1)
    $ renpy.pause(3, hard=True)
    scene cg poligon_yulya_forest at poligon_blur
    show poligon_kust1 
    show poligon_kust2
    with Fade(1,0.5,1)
    "Раздвинув кусты, я увидел довольно странную картину."
    play sound poligon_listva
    show poligon_kust2:
        xpos 960
        ease 1 xpos 2000
    $ renpy.pause (1.5, hard=True)
    play sound2 poligon_listva
    show poligon_kust1:
        xpos 960
        ease 1 xpos -500
    $ renpy.pause(1, hard=True)
    stop ambience fadeout 1
    play music poligon_who_are_you fadein 2
    if persistent.poligon_arts["yulya_forest_arh"]["unlocked"] == False and persistent.poligon_music["who_are_you"]["unlocked"] == False:
        $ persistent.poligon_arts["yulya_forest_arh"]["unlocked"] = True
        $ persistent.poligon_music["who_are_you"]["unlocked"] = True
    scene cg poligon_yulya_forest with dissolve
    "Одинокая девушка, сидящая на такой же одинокой траве посреди совсем маленькой полянки, окруженной густым лесом."
    ptho "Это что-то новенькое."
    semen "Эй...{w} Ты кто?"
    "Она встрепенулась, словно испуганный зверёк."
    "На ней была разорванная больничная роба, испачканная чем-то тёмным. А ещё... {w}Уши. И хвост.{w} Настоящие, пушистые, будто у кошки."
    ptho"Я что, сплю?{w} Или на завтрак что-то не то съел?"
    semen "Ты... В порядке? Ты ранена?"
    scene cg poligon_yulya_forest:
        ease 1 zoom 1.05 xoffset -25 yoffset -25
    $ renpy.pause (1, hard=True)
    play sound poligon_shipenie
    scene cg poligon_yulya_forest_2:
        zoom 1.05 xoffset -25 yoffset -25
    if persistent.poligon_arts["yulya_forest_2_arh"]["unlocked"] == False:
        $ persistent.poligon_arts["yulya_forest_2_arh"]["unlocked"] = True
    "Она зашипела. Буквально, как рассерженная кошка." with hpunch
    scene cg poligon_yulya_forest_2:
        zoom 1.05 xoffset -25 yoffset -25
        ease 0.4 zoom 1.0 xoffset 0 yoffset 0
    $ renpy.pause (0.3, hard=True)
    "Я отступил на шаг, подняв руки. Ее глаза были заполнены ненавистью...{w} Нет, скорее страхом."
    "Желтая склера глаза не давала спокойно отпустить руки."
    semen "Ты человек? Ты вообще, что такое?"
    noname "Не подходи!"
    semen "Ну, если ты скажешь, что ты такое, то будет проще."
    scene cg poligon_yulya_forest with Dissolve(0.7)
    noname "Ни человек, ни животное."
    semen "Легче не стало...{w} Ладно, потом разберемся, ты, вроде, не спешишь мне глотку вскрыть."
    ptho "Она хоть не бешеная, надеюсь?.."
    scene cg poligon_yulya_forest:
        subpixel True
        parallel:
            xanchor 0.5 yanchor 0.5 xpos 0.5 ypos 0.5
            zoom 1.01
            ease 7 zoom 1.05
        parallel:
            ease 1 xoffset 0 yoffset -8
            ease 1 xoffset -9 yoffset 7
            ease 1 xoffset 0 yoffset -7
            ease 1 xoffset 15 yoffset 7
            repeat
    $ renpy.pause(4, hard=True)
    play sound poligon_shipenie
    scene cg poligon_yulya_forest_2:
        subpixel True
        xanchor 0.5 yanchor 0.5 xpos 0.5 ypos 0.5
        zoom 1.0329
        block:
            linear 0.05 xoffset 10 yoffset 2
            linear 0.01 xoffset 0 yoffset 0
            linear 0.05 xoffset -10 yoffset -2
            linear 0.01 xoffset 0 yoffset 0
            repeat 4
        pause 0.8
        ease 1.5 zoom 1.0
    $ renpy.pause (2.8, hard=True)
    "Я начал подходить к ней поближе, но решительный крик этого существа меня остановил." with dspr
    semen "Ладно, не подхожу. Но ты же понимаешь, что в таком виде по лесу шляться — не лучшая идея."
    "Острый зрачок ее глаз пытался залезть в мышцы моего сердца и выпытать все, до чего дотянется."
    "Если говорить честно — я испугался."
    "Вроде бы я гулял, как всегда, по тому же самому лесу, по той же самой тропе."
    "Старался просто проветрить голову от постоянных, острых, словно леска, наматывающихся мыслей. Но вдруг встретил нечто совсем чужое."
    scene cg poligon_yulya_forest with dissolve
    noname "Я..{w} Не помню."
    ptho "Отлично. Значит, я не один такой \"забывчивый\"."
    semen "Слушай, я могу сбегать в лагерь, принести тебе нормальную одежду и чего-нибудь поесть. Как ты смотришь на это?"
    "Она не ответила, но и не убежала. Продолжала сидеть на траве, остро смотря на мои попытки сблизиться. Но я счел, что она согласна."
    ptho"Ну, хоть кто-то ещё более потерянный, чем я. Если я не помогу сейчас, то не знаю, как буду в зеркало смотреть."
    "Это было последнее, о чем я подумал прежде, чем начал возвращаться в лагерь."
    stop ambience fadeout 2
    stop music fadeout 2
    play ambience poligon_camp_center_evening fadein 2
    scene bg poligon_ext_square_sunset with Fade(2,1.5,2)
    "Я шёл на цыпочках, будто украдкой пробирался по вражеской территории."
    "Хотя, если честно, после встречи в лесу всё здесь начало казаться подозрительно мирным. Слишком уж мирным."
    "Надо было найти одежду. В голову тут же пришел склад — я направился туда, надеясь, что никто меня не остановит по пути."
    scene bg poligon_ext_warehouse_sunset with Fade(2,1.5,2)
    "Так и случилось, не было никаких ненужных спонтанных встреч. Это радует."
    ptho "Не хватало еще напороться на Ольгу Дмитриевну..."
    "Склад встретил откровенно потертыми белыми кирпичами и изношенной дверью. Он выглядел так, будто его не закрывали со времён прошлой смены."
    "Хорошо, что дверь оказалась приоткрыта. Мне не составило особого труда войти внутрь."
    play sound poligon_door_squeak_light
    scene bg poligon_int_warehouse_sunset with dissolve 
    ptho "Так... Надеюсь, здесь есть что-нибудь приличное. Не хочется возвращаться к ней с грязной тряпкой."
    "Запах пыли и старой ткани врезался в нос."
    "Склад был наполнен всякой всячиной: от старых постановочных костюмов до грабель, лопат и мешков с сахаром. Впрочем, я видел это не в первый раз."
    "Присев к нижней полке, я начал рыться среди аккуратно — ну, почти аккуратно — сложенных вещей."
    play sound poligon_clothes fadein 0.2
    "Спустя пару минут мне удалось нащупать что-то более-менее подходящее."
    "Из какой-то одинокой коробки я вытащил коричневое платье. Простое, деревенское, но чистое."
    "Размер, кажется, подходящий. Не модный шик, конечно, но и сейчас не то время, чтобы думать о таком."
    ptho "Что-ж, с одеждой разобрался. Осталось найти еды для новой знакомой."
    ptho "Тогда нужно идти в столовую."
    "Я покинул склад и отправился за пропитанием."
    scene bg poligon_ext_square_sunset at poligon_move(1)
    with Fade(2,1.5,2)
    $ renpy.pause(1.3, hard=True)
    scene bg poligon_ext_dining_hall_away_sunset with dissolve2
    "По пути мне не встретился никто, кто мог бы задать неподходящие вопросы."
    ptho "Как-то всё слишком хорошо..."
    stop ambience fadeout 1
    play sound poligon_door_squeak_light
    scene bg poligon_int_dining_hall_sunset with Dissolve(1.5)
    play ambience poligon_dining_hall_empty fadein 2
    "Зайдя в столовую, я почувствовал запах жареных котлет и картошки — самое время ловить повариху до того, как она успеет уйти."
    "Она стояла за прилавком, протирая руки о фартук и что-то ворча себе под нос — типичная полноразмерная картина, радовавшая каждый аппетитный желудок."
    semen "Здравствуйте! Скажите, можно ли взять ещё одну порцию ужина?"
    show nt nt_normal normal with dissolve
    povar "А тебе не хватило? Или опять кто-то за компанию решил поживиться?"
    semen "Нет-нет, правда. Просто...{w} один из ребят плохо себя чувствует. Говорит, что встать не может - живот схватило. Вот я и решил помочь."
    show nt nt_pdzrv normal with dspr
    "Повариха прищурилась, оценивающе посмотрела на меня — будто хотела просканировать насквозь."
    "Я старался выглядеть как можно более обеспокоенным и искренним, будто маленький мальчик, что так желает помочь своему собрату на футбольной площадке. Все-таки мне нельзя подавать вид, что что-то не так."
    povar "М-да. Всё самодеятельность. Ладно уж, на — только потом посуду не забудь вернуть, а парню тому скажи, чтоб в медпункт шел."
    semen "Спасибо большое!"
    hide nt with dissolve
    "Я схватил порцию — хлеб, пюре, котлета — и поспешил к выходу, пока она не передумала."
    "Наша повариха была очень непредсказуема, поэтому медлить точно нельзя."
    "Всё, теперь с едой и одеждой можно возвращаться."
    ptho "Надеюсь, она еще не успела уйти, а то мой непонятно откуда зародившийся спасательный круг утонет вместе с любой будущей добротой."
    stop ambience fadeout 1
    play ambience poligon_forest_evening fadein 1
    scene cg poligon_yulya_forest with Fade(2,1.5,2)
    "Девушка сидела на том же месте."
    "Увидев меня, она насторожилась, но не убежала. Видимо, в детстве успела прочитать присказку о рыцаре на белом коне. Это не могло не радовать."
    semen "Держи. Переоденься, а то в больничном халате ты смотришься не очень."
    "Она взяла одежду, но не двигалась. Я понял намёк и отвернулся, уставившись на сосну."
    scene bg poligon_ext_polyana_sunset with dissolve
    ptho "Интересно, она вообще человек?"
    play sound poligon_clothes
    "Тихий шорох."
    show uv uv_normal_blood normal with dissolve
    "Я обернулся — теперь она выглядела почти как обычная девочка, если не считать ушей и хвоста, которые она, кажется, даже не пыталась скрыть."
    semen "Так-то лучше. Ну что, имя-то своё вспомнила?"
    "Она долго молчала, потом прошептала:"
    uvao "Юля."
    ptho "Хоть что-то..."
    semen "Я Семён. Ну что, Юля, прогуляемся? Может, виды что-то нажмут в твоей памяти."
    show uv uv_guilty_blood normal with dspr 
    uvao "Проводи меня к речке."
    "Над ней, словно ангел, снизошла человеческая сущность. Она плотней сжалась в новое платье, а зрачки потускнели и пытались раствориться в закатном сиянии солнца."
    semen "Какой это?"
    show uv uv_smile_blood normal with dspr
    uvao "Тут, вроде, течет речка. Ты знаешь, где она?"
    semen "Речка?.."
    ptho "Так... Я помню прибойный звук откуда-то из глуши, может, она про него?"
    semen "Вроде что-то припоминаю. Ты хочешь туда?"
    show uv uv_smile_blood normal with dspr
    uvao "Да, пожалуйста... Отведи."
    semen " Ну, тогда идем!"
    play music poligon_progulka fadein 1.5
    play sound poligon_listva
    scene bg poligon_ext_forest4_sunset with Dissolve(1.2)
    "Девочка с ушами, будто совсем не из этого мира."
    "Я чувствую какую-то мимолётную схожесть с этой душой. Вместе с интересом на моих плечах лежало глубокое непонимание принципов её существования."
    "Впрочем, хоть и не медленно, но оно отступало, параллельно вспоминая свои личные ощущения по поводу своего глубокого, зарытого субъективного восприятия этого мира.{w} Что-то было явно не так."
    uvao "Ай..."
    semen "Что такое?"
    if persistent.poligon_arts["ranka_1_arh"]["unlocked"] == False:
        $ persistent.poligon_arts["ranka_1_arh"]["unlocked"] = True
    scene cg poligon_ranka_1 with dissolve
    "Я обернулся и увидел, как Юля поцарапалась об колючие ветки кустов, через которые мы старались пробраться."
    semen "Осторожней."
    play sound poligon_regen
    scene cg poligon_ranka_2 with dissolve
    $ renpy.pause (0.5, hard=True)
    scene cg poligon_ranka_3 with dspr
    if persistent.poligon_arts["ranka_2_arh"]["unlocked"] == False and persistent.poligon_arts["ranka_3_arh"]["unlocked"] == False:
        $ persistent.poligon_arts["ranka_2_arh"]["unlocked"] = True
        $ persistent.poligon_arts["ranka_3_arh"]["unlocked"] = True
    "Порез был в районе запястья, но кровь быстро остановилась, и рана медленно начала затягиваться."
    ptho "Значит, ты отличаешься не только ушками да хвостиком. Кто же ты?..{w} Или, что ты?"
    scene bg poligon_ext_forest4_sunset
    show uv uv_normal_blood normal
    with dissolve
    semen "Откуда ты, Юля?"
    uvao "Я не помню. Только обрывки."
    "Ее тон голоса подрывал всякое желание продолжать выкапывать, скорее всего, неприятную яму из прошлого. Это можно было понять, хотя бы по ее прошлой одежке."
    "Честно, казалось, что она сбежала из какого-нибудь психоневрологического диспансера..."
    semen "Осталось совсем чуть-чуть, если хочешь, можем отдохнуть."
    show uv uv_upset_blood normal with dspr
    uvao "Нет. Идем дальше."
    "Резкое понижение голоса дало понять, что останавливаться лучше не стоит."
    show uv uv_smile_blood normal with dspr
    uvao "Речка! Вон там!"
    "Она указывала куда-то направо, вглубь лесной чащи."
    ptho "Странно, я ничего не слышу."
    uvao "Идём, идём."
    hide uv with dissolve
    "Юля будто бы восстановилась, она обогнала меня и грубо расталкивала ветви на своем пути."
    play sound poligon_run_forest
    scene bg poligon_ext_forest4_sunset at poligon_move(0.3)
    semen "Подожди меня!"
    "Я старался не потерять ее из виду. Сейчас вела уже она, а я пытался поспеть за ней. Все-таки не хочется потерять новую подругу так скоро."
    "Спустя еще минут пять я начал слышать звуки воды, а через десять мы смогли выйти к ней."
    stop ambience fadeout 2
    play ambience poligon_river_normal fadein 1
    scene bg poligon_ext_forest_streamlet_sunset with dissolve
    if persistent.poligon_bg["ext_forest_streamlet_sunset_arh"]["unlocked"] == False:
        $ persistent.poligon_bg["ext_forest_streamlet_sunset_arh"]["unlocked"] = True
    uvao "Помню это место. Я здесь раньше была, но когда именно - совсем не помню."
    "Измученное лицо девы."
    ptho "Как давно передо мной раскрывалась такая картина?"
    "Я не знаю. Не могу вспомнить даже самое банальное и простое, но сейчас не хочется даже думать и рыться в пыльном шкафу воспоминаний, который даже не могу понять."
    semen "Тебе здесь нравится?"
    uvao "Да, здесь спокойно и уютно. Очень."
    "Она сомкнула пальцы в подобие кулачков и зависла в спокойных звуках течения воды. Мне не хотелось трогать ее, казалось, что она там, где должна быть."
    "Подойдя к воде ближе, мы просидели, кажется, час."
    "Может быть, чуть меньше, но за это время она успела успокоиться. Сейчас она казалась мне совсем невинной."
    "Во время того, как мы наслаждались влажным воздухом, Юля успела смыть всю оставшуюся кровь со своего тела."
    show uv uv_smile normal with dissolve
    uvao "Идём дальше."
    "Она резко поднялась, не давая прийти в себя."
    semen "Куда?"
    uvao "Погуляем по лесу ещё. Ноги устали сидеть."
    uvao "Ну, пошли."
    hide uv with dissolve
    "Следом за ней поднялся и я."
